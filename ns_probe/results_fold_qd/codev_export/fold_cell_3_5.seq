! CODE V export : fold_cell_3_5
! dom_signature : T@A -> TIR@D -> TIR@B -> TIR@B -> T@B
! CODEV Z=engine_x (axis), Y=engine_y, X=out-of-plane; cylinders along X
! Global coords: every surface DECENTER-AND-RETURN (DAR), THI 0 -> one frame.
! Curved faces = spheres (meridionally exact); TIR faces = TIRO (stay in glass n).
LEN NEW
DIM M
WL 587.56
REF 1
EPD 8.000000
YAN 26.198546
! ---- constant-index model glass (private catalog; worked in live trace)
PRV
PWL 587.56
'FOLDN' 1.500000
END
! ---- object at infinity (radius 0, huge thickness)
SO 0 1e18
! ---- S1: decentered aperture STOP at engine x=0 (input beam offset+width)
YDE S1 -13.068824
DAR S1
STO S1
! S2: refract @face A (entry)
S -47.046054 0 'FOLDN'
YDE S2 0.000000
ZDE S2 86.731649
ADE S2 14.311650
DAR S2
! S3: tir @face D (fold)  [TIR]
S 0 0 TIRO 'FOLDN'
YDE S3 30.000000
ZDE S3 80.896111
ADE S3 90.000000
DAR S3
! S4: tir @face B (fold)  [TIR]
S -96.573960 0 TIRO 'FOLDN'
YDE S4 0.000000
ZDE S4 99.949406
ADE S4 1.058663
DAR S4
! S5: tir @face B (fold)  [TIR]
S -96.573960 0 TIRO 'FOLDN'
YDE S5 0.000000
ZDE S5 99.949406
ADE S5 1.058663
DAR S5
! S6: refract @face B (exit)
S -96.573960 0
YDE S6 0.000000
ZDE S6 99.949406
ADE S6 1.058663
DAR S6
! image: plane at engine x=120.0
SI 0 0
ZDE SI 120.000000
DAR SI
GO
