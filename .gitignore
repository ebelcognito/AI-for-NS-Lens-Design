# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- Node ---
node_modules/
npm-debug.log*

# --- Run artifacts: results, renders, logs ---
# Search/optimisation output is regenerated by the pipeline, not source.
# EXCEPTION: ns_probe/results_fold_qd/ is force-added -- it holds the fold
# archive the CODE V exporters read, plus the CODE V export itself.
results_*/
!ns_probe/results_fold_qd/
logs_disc/
logs_disc_prism/
renders/
*.log

# --- Images: this repo is code only ---
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tif
*.tiff

# --- Large binary data ---
*.npy
*.npz
*.db

# --- Secrets: NEVER commit ---
# A GitHub PAT in optical_rl/pat.txt was caught by push protection on the first
# push attempt. Keep this list ahead of any new file that holds a credential.
pat.txt
.env
.env.*
.netrc
.npmrc
*.pem
*.key
id_rsa*
id_ed25519*
*secret*
*token*
*credential*

# --- Editor / OS / misc ---
.companion/
.DS_Store
*.swp
*.bak
*.bak-*
