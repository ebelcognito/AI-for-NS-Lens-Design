# --- Secrets: NEVER commit ------------------------------------------------
# A GitHub PAT in optical_rl/pat.txt was caught by push protection on the first
# push attempt. Keep this list ahead of any new file that holds a credential.
pat.txt
.env
.env.*
.netrc
.npmrc
*.pem
*.key
id_rsa*
id_ed25519*
*secret*
*token*
*credential*

# --- Run outputs -----------------------------------------------------------
# Search/optimisation output is regenerated by the pipeline, not source.
# 125 MB of it lives in runs/; legacy in-tree paths are symlinks into runs/.
runs/
ns_probe/results*
ns_autodiff/results*
logs_disc/
logs_disc_prism/
renders/
*.log

# EXCEPTION: results_fold_qd is a real directory, not a symlink, and is TRACKED.
# It holds the canonical fold archive the CODE V exporters read, plus the CODE V
# export itself (60 .seq/.spec/answer-key files). Deliverable, not run output.
!ns_probe/results_fold_qd/

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# --- Vendored JS engine ----------------------------------------------------
# ray-optics/src is VENDORED ON PURPOSE: it carries uncommitted engine mods
# (typed interactions + energy ledger, incl. integrations/runner_persistent.js).
# Only its deps and its inert upstream history are ignored.
ray-optics/node_modules/
ray-optics/.git-upstream/
ray-optics/dist/
ray-optics/.parcel-cache/
node_modules/
npm-debug.log*

# --- Images: this repo is code only ----------------------------------------
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tif
*.tiff

# --- Large binary data -----------------------------------------------------
*.npy
*.npz
*.db

# --- Archives / editor / OS ------------------------------------------------
*.tar.gz
.companion/
scratch/
.DS_Store
*.swp
*.bak
*.bak-*
